---
import {getEntry} from "astro:content"
import JournalNavigation from "../components/JournalNavigation.astro"
import Link from "../components/Link.astro"
import {formatDate} from "../utils/dates"
import DefaultLayout from "./Default.astro"

const {frontmatter} = Astro.props
const {slug} = Astro.params
if (!slug) throw new Error("slug is required")

const post = await getEntry("posts", slug)
if (!post) throw new Error(`Post ${slug} not found`)
---

<DefaultLayout
	title={`${frontmatter.title} | Sam King`}
	description={frontmatter.excerpt}
	ogImage={`/journal/${slug}.og.png`}
>
	<article>
		<nav class="mb-10">
			<p><Link href="/journal">All entries</Link></p>
		</nav>
		<header class="mb-5">
			<h1 class="font-bold">{frontmatter.title}</h1>
			<p class="text-muted-foreground tabular-nums slashed-zero">
				{formatDate(frontmatter.date)}
			</p>
		</header>
		<slot />
	</article>

	<hr class="h-px bg-border border-none" />

	<JournalNavigation collection="posts" id={post.id} />

	<footer>
		<p class="text-muted-foreground">Like this post?</p>
		<p>
			<Link href="/rss.xml">Subscribe via RSS</Link>
		</p>
	</footer>
</DefaultLayout>
