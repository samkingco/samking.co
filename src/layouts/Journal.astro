---
import {getCollection, getEntry} from "astro:content"
import Link from "../components/Link.astro"
import {formatDate} from "../utils/dates"
import DefaultLayout from "./Default.astro"

const {frontmatter} = Astro.props
const {slug} = Astro.params
if (!slug) throw new Error("slug is required")

const post = await getEntry("posts", slug)
if (!post) throw new Error(`Post ${slug} not found`)

const allPosts = await getCollection("posts")
const posts = allPosts.sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const currIndex = allPosts.findIndex((entry) => entry.id === slug)
const readNext =
	currIndex === posts.length - 1 ? undefined : posts[currIndex + 1]
const readPrev = currIndex === 0 ? undefined : posts[currIndex - 1]
---

<DefaultLayout
	title={`${frontmatter.title} | Sam King`}
	description={frontmatter.excerpt}
	ogImage={`/journal/${slug}.og.png`}
>
	<article>
		<header class="mb-3">
			<p class="text-muted-foreground tabular-nums slashed-zero">
				{formatDate(frontmatter.date)}
			</p>
			<h1 class="font-bold">{frontmatter.title}</h1>
		</header>
		<slot />
	</article>

	<hr class="h-px bg-border border-none" />

	<nav class="space-y-10">
		{readNext && <div>
			<p class="text-muted-foreground">Read next</p>
			<p>
				<Link href={`/journal/${readNext.id}`}>{readNext.data.title}</Link>
			</p>
		</div>}
		{readPrev && <div>
			<p class="text-muted-foreground">Previous entry</p>
			<p>
				<Link href={`/journal/${readPrev.id}`}>{readPrev.data.title}</Link>
			</p>
		</div>}
	</nav>

	<footer>
		<p class="text-muted-foreground">Like this post?</p>
		<p>
			<Link href="/rss.xml">Subscribe via RSS</Link>
		</p>
	</footer>
</DefaultLayout>
