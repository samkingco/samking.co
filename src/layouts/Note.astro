---
import type {CollectionEntry} from "astro:content"
import JournalNavigation from "../components/JournalNavigation.astro"
import Link from "../components/Link.astro"
import {siteConfig} from "../site.config"
import {formatDate} from "../utils/dates"
import DefaultLayout from "./Default.astro"

interface Props {
	entry: CollectionEntry<"notes">
}

const {entry} = Astro.props
const date = formatDate(entry.data.date)
---

<DefaultLayout title={`${date} | Sam King`}>
	<article>
		<nav class="mb-10">
			<p><Link href="/journal">All entries</Link></p>
		</nav>
		<header class="mb-5">
			<h1 class="text-muted-foreground">Note</h1>
			<p class="text-muted-foreground tabular-nums slashed-zero">
				<time datetime={entry.data.date.toISOString()}>{date}</time>
			</p>
		</header>
		<slot />
	</article>

	<hr class="h-px bg-border border-none" />

	<JournalNavigation collection="notes" id={entry.id} />

	<footer>
		<p class="text-muted-foreground">Like this note?</p>
		<p>
			<Link href="/rss.xml">Subscribe via RSS</Link>
		</p>
		<p>
			<Link href={siteConfig.supportUrl}>Support my work</Link>
		</p>
	</footer>
</DefaultLayout>
