---
import SiteHeader from "../components/SiteHeader.astro"
import RootLayout from "./Root.astro"

interface Props {
	title: string
	description?: string
	ogImage?: string
	wide?: boolean
}
const {wide = false, ...props} = Astro.props
---

<RootLayout {...props}>
	<main
		class:list={[
			"mx-5 md:mx-10 pt-10 pb-40 space-y-10",
			!wide && "max-w-[72ch]",
		]}
	>
		<SiteHeader />

		<slot />
	</main>
</RootLayout>
