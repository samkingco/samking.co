---
import {getCollection} from "astro:content"
import {Image} from "astro:assets"
import * as v from "valibot"
import avatarImage from "../assets/avatar.jpg"
import Link from "../components/Link.astro"
import Markdown from "../components/Markdown.astro"
import {siteConfig} from "../site.config"
import Layout from "../layouts/Default.astro"
import {PhotoEntrySchema} from "../photos/schema.ts"
import {photoDetailHref} from "../photos/context.ts"

const latestPhotos = siteConfig.photos.enabled
	? (await getCollection("photos"))
			.map((entry) => v.parse(PhotoEntrySchema, entry.data))
			.sort((left, right) => right.position - left.position)
			.slice(0, 4)
	: []
---

<Layout title="Sam King">
	<section class="space-y-5">
		<article aria-label="Introduction" class="space-y-5">
			<Image
				src={avatarImage}
				alt="Sam King"
				class="w-full h-auto max-w-24"
				loading="eager"
				width="96"
				height="96"
				densities={[1, 2, 3]}
			/>
			{siteConfig.bio.map((paragraph) => <Markdown content={paragraph} />)}
		</article>

		{
			siteConfig.photos.enabled && (
				<figure>
					<figcaption class="flex gap-3 mb-2">
						<h3 class="text-muted-foreground">Recent photos</h3>
						<Link href="/photos/">See all</Link>
					</figcaption>
					<div class="grid grid-cols-[repeat(4,minmax(0,--spacing(24)))] items-start gap-2">
						{latestPhotos.map((photo) => (
							<a
								href={photoDetailHref(photo.id)}
								aria-label={`View ${photo.metadata.title ?? photo.metadata.headline ?? "untitled photo"}`}
								class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
							>
								<img
									src={photo.thumbUrl}
									width={photo.metadata.width}
									height={photo.metadata.height}
									alt=""
									loading="lazy"
									class="aspect-square block h-auto w-full object-cover"
								/>
							</a>
						))}
					</div>
				</figure>
			)
		}

		<article>
			<h3 class="text-muted-foreground">Meaningful to me</h3>
			<Markdown content={siteConfig.coreValues} />
		</article>

		<article>
			<h3 class="text-muted-foreground">Big fan of</h3>
			<Markdown content={siteConfig.bigFanOf} />
		</article>

		<article>
			<h3 class="text-muted-foreground">Email</h3>
			<p>
				<Link href="mailto:mail@samking.co" rel="me"> mail@samking.co </Link>
			</p>
		</article>

		<article>
			<h3 class="text-muted-foreground">More</h3>
			<ul class="flex gap-3 flex-wrap">
				<li>
					<Link href="/journal" rel="me">Journal</Link>
				</li>
				<li>
					<Link href="/now" rel="me">Now</Link>
				</li>
				<li>
					<Link href="/freelance" rel="me">Freelance</Link>
				</li>
				<li>
					<Link href="/links" rel="me">Links</Link>
				</li>
				<li>
					<Link href="/cv" rel="me">CV</Link>
				</li>
			</ul>
		</article>
	</section>
</Layout>
