---
import {getCollection} from "astro:content"
import * as v from "valibot"
import PhotoCollection from "../../../../components/PhotoCollection.astro"
import PhotoPageBar from "../../../../components/PhotoPageBar.astro"
import SiteHeader from "../../../../components/SiteHeader.astro"
import Layout from "../../../../layouts/Photos.astro"
import type {PhotoContextReference} from "../../../../photos/context.ts"
import {
	capturedDate,
	newestCaptureFirst,
} from "../../../../photos/presentation.ts"
import {type PhotoEntry, PhotoEntrySchema} from "../../../../photos/schema.ts"

export async function getStaticPaths() {
	const photos = (await getCollection("photos"))
		.map((entry) => v.parse(PhotoEntrySchema, entry.data))
		.filter((photo) => capturedDate(photo.metadata.capturedAt))

	const groups = new Map<string, PhotoEntry[]>()

	for (const photo of photos) {
		const date = capturedDate(photo.metadata.capturedAt)
		if (!date) {
			continue
		}
		const key = date.slice(0, 7)
		const group = groups.get(key) ?? []
		group.push(photo)
		groups.set(key, group)
	}

	return [...groups].map(([date, items]) => {
		const [year, month] = date.split("-")
		return {
			params: {year, month},
			props: {
				photos: items.sort(newestCaptureFirst),
			},
		}
	})
}

interface Props {
	photos: PhotoEntry[]
}

const {photos} = Astro.props
const year = v.parse(v.string(), Astro.params.year)
const month = v.parse(v.string(), Astro.params.month)
const title = new Intl.DateTimeFormat("en-GB", {
	month: "long",
	year: "numeric",
	timeZone: "UTC",
}).format(new Date(Date.UTC(Number(year), Number(month) - 1, 1)))
const context: PhotoContextReference = {type: "date", id: `${year}-${month}`}
---

<Layout title={`Photos from ${title} | Sam King`} ogImage={photos[0]?.ogUrl}>
	<main class="pt-10 pb-40">
		<div class="px-5 md:px-10">
			<SiteHeader />
		</div>
		<section class="mt-8 space-y-8">
			<PhotoPageBar
				crumbs={[
					{label: "Photos", href: "/photos/"},
					{label: "Date", href: "/photos/browse/"},
					{label: title, count: photos.length},
				]}
			/>
			<PhotoCollection photos={photos} context={context} />
		</section>
	</main>
</Layout>
