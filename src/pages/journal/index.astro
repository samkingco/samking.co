---
import {render} from "astro:content"
import Link from "../../components/Link.astro"
import Layout from "../../layouts/Default.astro"
import {getJournalEntries} from "../../utils/journal"
import {formatDate} from "../../utils/dates"
import {journalPath} from "../../utils/journal-path"

const entries = await getJournalEntries()
const journal = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		Content:
			entry.collection === "notes" ? (await render(entry)).Content : null,
	})),
)
---

<Layout title="Journal">
	<div class="flex items-baseline gap-1">
		<h1>Journal</h1>
		<span class="text-muted-foreground/60" aria-hidden="true">•</span>
		<span
			class="[&_a]:text-muted-foreground [&_a:hover]:text-foreground [&_a:focus-visible]:text-foreground"
		>
			<Link href="/rss.xml">RSS</Link>
		</span>
	</div>
	{journal.map(({entry, Content}) => <article class="space-y-2">
		{entry.collection === "posts" ? (
			<>
				<header>
					<Link href={journalPath(entry)}>
						<h2 class="font-bold">{entry.data.title}</h2>
					</Link>
					<p class="text-muted-foreground">
						{formatDate(entry.data.date)}
					</p>
				</header>
				<p>{entry.data.excerpt}</p>
			</>
		) : (
			<>
				<header>
					<p class="text-muted-foreground">
						<Link href={journalPath(entry)}>Note</Link>
					</p>
					<p class="text-muted-foreground">
						{formatDate(entry.data.date)}
					</p>
				</header>
				<div class="markdown">{Content && <Content />}</div>
			</>
		)}
	</article>)}
</Layout>
