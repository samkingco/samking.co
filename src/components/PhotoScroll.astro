---
import type {PhotoContextReference} from "../photos/context.ts"
import {photoDetailHref} from "../photos/context.ts"
import type {PhotoEntry} from "../photos/schema.ts"
import {formatPhotoDate, photoTitle} from "../photos/presentation.ts"

interface Props {
	photos: PhotoEntry[]
	context?: PhotoContextReference
}

const {photos, context} = Astro.props
---

<article
	id="photo-view-scroll"
	class="scroll-mt-20 space-y-10 px-5 md:px-10"
	data-photo-view="scroll"
	hidden
>
	{photos.map((photo) => <figure
		style={`width: min(100%, ${photo.metadata.width}px, calc(70dvh * ${photo.metadata.width / photo.metadata.height}))`}
	>
		<a
			href={photoDetailHref(photo.id, context)}
			data-photo-id={photo.id}
			style={`aspect-ratio: ${photo.metadata.width} / ${photo.metadata.height}`}
			class="block w-full scroll-mt-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
		>
			<img
				src={photo.detailUrl}
				width={photo.metadata.width}
				height={photo.metadata.height}
				alt={photo.metadata.alt ?? photo.metadata.caption ?? ""}
				loading="lazy"
				class="block size-full object-contain object-top-left"
			/>
		</a>
		<figcaption class="flex items-baseline justify-between gap-4 pt-2">
			<span>{photoTitle(photo)}</span>
			<span class="shrink-0 text-muted-foreground">
				{formatPhotoDate(photo.metadata.capturedAt)}
			</span>
		</figcaption>
	</figure>)}
</article>
