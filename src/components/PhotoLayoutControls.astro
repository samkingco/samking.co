---
const layoutOptions = [
	{label: "Grid", value: "grid"},
	{label: "Scroll", value: "scroll"},
	{label: "Index", value: "index"},
]
---

<nav
	aria-label="Photo layout"
	class="flex shrink-0 items-baseline gap-x-2"
	data-photo-layout-controls
>
	{layoutOptions.map(({label, value}, index) => (
		<>
			<button
				type="button"
				class="cursor-pointer text-muted-foreground underline underline-offset-[0.125em] decoration-muted-foreground/80 decoration-dotted hover:text-foreground hover:decoration-solid hover:decoration-foreground focus-visible:text-foreground focus-visible:outline-none focus-visible:decoration-solid focus-visible:decoration-foreground active:decoration-solid active:decoration-foreground aria-pressed:text-foreground aria-pressed:no-underline disabled:cursor-default"
				aria-controls={`photo-view-${value}`}
				aria-pressed={value === "grid" ? "true" : "false"}
				disabled={value === "grid"}
				data-photo-layout-option={value}
			>
				{label}
			</button>
			{index < layoutOptions.length - 1 && <span
				class="text-muted-foreground/60"
				aria-hidden="true"
			>
				•
			</span>}
		</>
	))}
</nav>

<script>
	import {registerPhotoLayouts} from "./PhotoLayoutControls.client.ts"
	registerPhotoLayouts()
</script>
