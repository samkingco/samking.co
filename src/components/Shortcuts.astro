---
import TextButton from "./TextButton.astro"
---

<dialog
	class="fixed inset-0 m-auto w-90 max-w-full bg-background px-3 py-2 text-foreground backdrop:bg-black/40 [&_kbd]:bg-muted [&_kbd]:px-1 [&_kbd]:py-0.5 [&_kbd]:leading-none"
	data-shortcuts
	aria-labelledby="shortcuts-title"
>
	<div class="flex items-center justify-between gap-3 px-3 pt-3">
		<h2 id="shortcuts-title">Shortcuts</h2>
		<form method="dialog">
			<TextButton type="submit" autofocus>Close</TextButton>
		</form>
	</div>
	<div class="space-y-3 px-3 pt-3 pb-5">
		<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
			<dt><kbd>i</kbd></dt>
			<dd>Show or hide info</dd>
			<dt><kbd>p</kbd></dt>
			<dd>Show or hide loupe</dd>
			<dt><kbd>+</kbd> / <kbd>-</kbd></dt>
			<dd>100% / Fit</dd>
			<dt><kbd>←</kbd> / <kbd>↑</kbd></dt>
			<dd>Previous photo</dd>
			<dt><kbd>→</kbd> / <kbd>↓</kbd></dt>
			<dd>Next photo</dd>
			<dt><kbd>Esc</kbd></dt>
			<dd>Close</dd>
			<dt><kbd>?</kbd></dt>
			<dd>Show shortcuts</dd>
		</dl>
	</div>
</dialog>

<script>
	import {registerShortcuts} from "./Shortcuts.client.ts"
	registerShortcuts()
</script>
