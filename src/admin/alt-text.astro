---
import {
	readGeneratedAltTextPhotos,
	saveReviewedAltText,
} from "../repos/photos/alt-text.ts"
import {
	openPhotoDatabase,
	openReadonlyPhotoDatabase,
} from "../repos/photos/database.ts"
import "../layouts/styles.css"

if (
	!["localhost", "127.0.0.1", "[::1]"].includes(Astro.url.hostname) ||
	!["127.0.0.1", "::1", "::ffff:127.0.0.1"].includes(Astro.clientAddress)
) {
	return new Response("Local access only", {status: 403})
}

if (Astro.request.method === "POST") {
	if (Astro.request.headers.get("Origin") !== Astro.url.origin) {
		return new Response("Invalid origin", {status: 403})
	}
	if (
		Astro.request.headers.get("Content-Type")?.split(";")[0] !==
		"application/json"
	) {
		return new Response("Expected JSON", {status: 415})
	}
	try {
		const input = await Astro.request.json()
		const database = openPhotoDatabase()
		try {
			saveReviewedAltText(database, input)
		} finally {
			database.$client.close()
		}
		return new Response(null, {status: 204})
	} catch (error) {
		return new Response(
			error instanceof Error ? error.message : "Save failed",
			{status: 400},
		)
	}
}

if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
	return new Response(null, {
		status: 405,
		headers: {Allow: "GET, HEAD, POST"},
	})
}

Astro.response.headers.set("Cache-Control", "no-store")
const database = openReadonlyPhotoDatabase()
let photos: ReturnType<typeof readGeneratedAltTextPhotos>
try {
	photos = readGeneratedAltTextPhotos(database)
} finally {
	database.$client.close()
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Alt text</title>
	</head>
	<body>
		<form method="post">
			<header>
				<h1>Alt text</h1>
				<output></output>
				<button type="submit" disabled={photos.length === 0}>Save</button>
			</header>
			{photos.length === 0 && <p>No generated alt text to review.</p>}
			<fieldset>
				{photos.map((photo) => <div>
					<img
						src={`/cdn/${photo.previewKey}`}
						width={photo.metadata.width}
						height={photo.metadata.height}
						alt={photo.altText ?? ""}
						loading="lazy"
					/>
					<textarea
						data-id={photo.id}
						data-input-hash={photo.inputHash}
						required
						maxlength="1000"
					>{photo.altText}</textarea>
				</div>)}
			</fieldset>
		</form>
	</body>
</html>

<script>
	const form = document.querySelector("form")!
	const fields = form.querySelector("fieldset")!
	const button = form.querySelector("button")!
	const output = form.querySelector("output")!

	form.addEventListener("submit", async (event) => {
		event.preventDefault()
		const edits = Array.from(form.querySelectorAll("textarea"), (field) => ({
			id: field.dataset.id,
			inputHash: field.dataset.inputHash,
			altText: field.defaultValue,
			text: field.value,
		}))
		button.disabled = true
		fields.disabled = true
		output.textContent = "Saving…"
		try {
			const response = await fetch(window.location.pathname, {
				method: "POST",
				headers: {"Content-Type": "application/json"},
				body: JSON.stringify(edits),
			})
			if (!response.ok) {
				throw new Error(await response.text())
			}
			window.location.reload()
		} catch (error) {
			output.textContent =
				error instanceof Error ? error.message : "Save failed"
			button.disabled = false
			fields.disabled = false
		}
	})
</script>

<style>
	body {
		padding: 2rem;
	}

	header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	h1 {
		margin-right: auto;
	}

	button {
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.5;
		cursor: default;
	}

	fieldset {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: 2rem;
		border: 0;
		padding: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	textarea {
		display: block;
		width: 100%;
		margin-top: 0.75rem;
		border: 0;
		padding: 0;
		background: transparent;
		font: inherit;
		field-sizing: content;
		resize: none;
	}
</style>
