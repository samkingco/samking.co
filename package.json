{
	"name": "astro",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"ship": "pnpm build && wrangler pages deploy",
		"photos": "node src/photos/cli.ts",
		"photos:db:generate": "drizzle-kit generate",
		"photos:db:migrate": "drizzle-kit migrate",
		"test:photos": "node --test src/photos/*.test.ts",
		"check": "astro check",
		"format": "oxfmt && prettier --write \"src/**/*.astro\"",
		"format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
		"lint": "oxlint && astro check",
		"lint:fix": "oxlint --fix && astro check"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.2",
		"@atcute/cbor": "^2.3.7",
		"@atcute/cid": "^2.4.2",
		"@atcute/lexicons": "^2.1.1",
		"@aws-sdk/client-s3": "^3.1136.0",
		"@inquirer/prompts": "^8.7.2",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^6.1.6",
		"commander": "^15.0.0",
		"drizzle-orm": "1.0.0-rc.4",
		"exifreader": "^4.45.1",
		"extract-colors": "^4.2.1",
		"fontaine": "^0.8.0",
		"fractional-indexing-jittered": "1.0.0",
		"markdown-it": "^14.1.1",
		"node-html-parser": "^7.1.0",
		"sanitize-html": "^2.17.2",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.3.3",
		"unist-util-visit-parents": "^6.0.2",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tailwindcss/typography": "^0.5.19",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.6.0",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "1.0.0-rc.4",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"prettier": "3.8.2",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.82.2"
	}
}
