{
	"name": "astro",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"ship": "pnpm build && wrangler pages deploy",
		"content": "node --env-file-if-exists=.env src/cli/index.ts",
		"photos:db:generate": "drizzle-kit generate",
		"photos:db:migrate": "drizzle-kit migrate",
		"test:atproto": "node --test src/atproto/*.test.ts",
		"test": "node --test src/atproto/*.test.ts src/repos/*.test.ts src/repos/photos/*.test.ts src/loaders/*.test.ts src/cli/*.test.ts src/utils/*.test.mjs",
		"check": "astro check",
		"format": "oxfmt && prettier --write \"src/**/*.astro\"",
		"format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
		"lint": "oxlint && astro check",
		"lint:fix": "oxlint --fix && astro check"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@atcute/atproto": "^4.0.4",
		"@atcute/bluesky": "^4.0.22",
		"@atcute/bluesky-richtext-builder": "^4.0.1",
		"@atcute/cbor": "^2.3.8",
		"@atcute/cid": "^2.5.0",
		"@atcute/client": "^5.1.2",
		"@atcute/identity": "^2.0.2",
		"@atcute/identity-resolver": "^2.0.2",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/password-session": "^1.0.2",
		"@atcute/tid": "^1.1.4",
		"@aws-sdk/client-s3": "^3.1140.0",
		"@clack/prompts": "^1.8.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"commander": "^15.0.0",
		"drizzle-orm": "1.0.0-rc.4",
		"exifreader": "^4.45.2",
		"extract-colors": "^4.2.1",
		"fontaine": "^1.0.0",
		"fractional-indexing-jittered": "1.1.0",
		"markdown-it": "^15.0.2",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-gfm": "^3.1.0",
		"micromark-extension-gfm": "^3.0.0",
		"node-html-parser": "^9.0.4",
		"sanitize-html": "^2.17.7",
		"satori": "^0.33.5",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tailwindcss/typography": "^0.5.20",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.2",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "1.0.0-rc.4",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.139.0"
	}
}
